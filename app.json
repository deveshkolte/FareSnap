{
  "expo": {
    "name": "FareSnap",
    "slug": "faresnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "faresnap",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deveshkolte.faresnap",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "uber",
          "olacabs",
          "in.rapido.passenger",
          "yatri",
          "blusmart",
          "merucabs",
          "meru",
          "indrive",
          "bharatcab",
          "savaari",
          "upi"
        ]
      }
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "queries": [
        "uber://",
        "olacabs://",
        "in.rapido.passenger://",
        "yatri://",
        "blusmart://",
        "merucabs://",
        "meru://",
        "indrive://",
        "bharatcab://",
        "savaari://",
        "porter://",
        "jugnoo://"
      ],
      "package": "com.deveshkolte.faresnap"
    },
    "androidStatusBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FareSnap to access your location to calculate ride fares."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90c36cf2-8642-461d-804d-50bf72051a50"
      }
    }
  }
}
