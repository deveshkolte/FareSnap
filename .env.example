# ============================================================
# FareSnap — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your own values.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================


# ------------------------------------------------------------------
# CLOUD BACKEND URLS (required for AI insights & ONDC gateway)
# ------------------------------------------------------------------
# If running the backend locally: http://localhost:4040
# If deployed to Render/Railway/etc: your production URL
EXPO_PUBLIC_ONDC_BAP_URL=https://your-render-service.onrender.com
EXPO_PUBLIC_AI_PROXY_URL=https://your-render-service.onrender.com/proxy/ai-insight


# ------------------------------------------------------------------
# OLA MAPS API KEY  (required for Indian autocomplete & routing)
# ------------------------------------------------------------------
# Get a free key at: https://olamaps.io/developers
# Used for city-locked place autocomplete and traffic-aware routing.
EXPO_PUBLIC_OLA_MAPS_API_KEY=your_ola_maps_api_key_here


# ------------------------------------------------------------------
# AI MODEL KEYS — stored on your backend server ONLY
# ------------------------------------------------------------------
# These go in the .env loaded by ondc-test/server.js (the cloud backend).
# They are NEVER embedded in the mobile app binary.
#
# Groq (primary): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
#
# Google Gemini (fallback): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here


# ------------------------------------------------------------------
# SUPABASE (optional — enables global crowdsourced surge pooling)
# ------------------------------------------------------------------
# Create a free project at: https://supabase.com
# Then run supabase/schema.sql in the SQL Editor to create the table.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# ------------------------------------------------------------------
# MONETIZATION (optional — affiliate & cashback referral links)
# ------------------------------------------------------------------
# These can be overridden anytime via the backend /monetization-config
# endpoint without rebuilding the app.
EXPO_PUBLIC_CUELINKS_PUB_ID=
EXPO_PUBLIC_SAVAARI_AFFILIATE_URL=
EXPO_PUBLIC_CASHBACK_OFFER_URL=
EXPO_PUBLIC_UPI_REFERRAL_URL=
EXPO_PUBLIC_POST_RIDE_PERK_URL=


# ------------------------------------------------------------------
# ONDC BAP CREDENTIALS (required only for official ONDC network listing)
# ------------------------------------------------------------------
# Generate keypairs with:  node ondc-test/generate-keys.js
# Register at: https://ref.ondc.org  (sandbox) or staging.ondc.org
ONDC_BAP_ID=your-bap-id.ondc.org
ONDC_BAP_URI=https://your-render-service.onrender.com/ondc
ONDC_BAP_PRIVATE_KEY=
ONDC_UNIQUE_KEY_ID=faresnap-key-1
ONDC_GATEWAY_URL=
