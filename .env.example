# FareSnap Backend & Client Environment Configuration
# 1. Server-side LLM keys (read by ondc-test/server.js for /proxy/ai-insight)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Client-side Backend Endpoints (Safe to bundle in APK)
EXPO_PUBLIC_ONDC_BAP_URL=http://localhost:4040
EXPO_PUBLIC_AI_PROXY_URL=http://localhost:4040/proxy/ai-insight

# 3. Optional: Ola Maps API Key (free tier at maps.olakrutrim.com for live Indian traffic duration)
EXPO_PUBLIC_OLA_MAPS_API_KEY=

# 4. Optional: Supabase URL & Anon Key for cloud Waze-style surge pooling
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
